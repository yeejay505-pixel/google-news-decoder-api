FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates openssl nginx chromium x11vnc websockify novnc xvfb curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone --depth 1 https://github.com/floomhq/openbrowser.git /app
RUN pip install -e . 'websockets>=13,<17' && python -m playwright install --with-deps chromium
RUN ln -s /usr/bin/chromium /usr/local/bin/google-chrome
COPY openbrowser_auth_nginx.conf /etc/nginx/conf.d/openbrowser.conf
RUN rm -f /etc/nginx/sites-enabled/default
COPY openbrowser_auth_start.sh /app/auth_start.sh
COPY g1_unit_history_adapter.py /app/g1_unit_history_adapter.py
COPY g1_history_events.py /app/g1_history_events.py
COPY test_g1_history_events.py /app/test_g1_history_events.py
COPY g1_evidence_store.py /app/g1_evidence_store.py
COPY test_g1_evidence_store.py /app/test_g1_evidence_store.py
COPY g1_inspect_http.py /app/g1_inspect_http.py
COPY test_g1_unit_history_adapter.py /app/test_g1_unit_history_adapter.py
COPY g1_webgl_launcher.sh /app/g1_webgl_launcher.sh
COPY g1_webgl_local_check.py /app/g1_webgl_local_check.py
COPY openbrowser_auth_verify.py /app/openbrowser_auth_verify.py
COPY openbrowser_continuity_inspect.py /app/openbrowser_continuity_inspect.py
COPY openbrowser_restored_tabs.py /app/openbrowser_restored_tabs.py
ENV OPENBROWSER_BROKER_HOST=127.0.0.1 OPENBROWSER_BROKER_ROOT=/data/openbrowser-broker OPENBROWSER_BROWSER_POOL_DIR=/data/openbrowser-pool OPENBROWSER_SLOT_COUNT=1
EXPOSE 8767
CMD ["sh","/app/auth_start.sh"]
