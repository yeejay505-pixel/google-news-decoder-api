FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates nginx chromium x11vnc websockify novnc xvfb curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone --depth 1 https://github.com/floomhq/openbrowser.git /app
RUN pip install -e . && python -m playwright install --with-deps chromium
RUN ln -s /usr/bin/chromium /usr/local/bin/google-chrome
COPY openbrowser_auth_nginx.conf /etc/nginx/conf.d/openbrowser.conf
RUN rm -f /etc/nginx/sites-enabled/default
COPY openbrowser_auth_start.sh /app/auth_start.sh
ENV OPENBROWSER_BROKER_HOST=127.0.0.1 OPENBROWSER_BROKER_ROOT=/data/openbrowser-broker OPENBROWSER_BROWSER_POOL_DIR=/data/openbrowser-pool OPENBROWSER_SLOT_COUNT=1 OPENBROWSER_PUBLIC_AUTH_BASE_URL=https://openbrowser-auth-poc-poc.up.railway.app OPENBROWSER_PUBLIC_NOVNC_BASE_URL=https://openbrowser-auth-poc-poc.up.railway.app/vnc
EXPOSE 8767
CMD ["sh","/app/auth_start.sh"]
