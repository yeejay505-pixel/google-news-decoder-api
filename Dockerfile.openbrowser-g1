FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone --depth 1 https://github.com/floomhq/openbrowser.git /app
RUN pip install -e . && python -m playwright install --with-deps chromium
ENV OPENBROWSER_BROKER_HOST=0.0.0.0 OPENBROWSER_BROKER_PORT=8767 OPENBROWSER_BROKER_ROOT=/data/openbrowser-broker OPENBROWSER_BROWSER_POOL_DIR=/data/openbrowser-pool
EXPOSE 8767
COPY openbrowser_g1_smoke.py /app/g1_smoke.py
CMD ["sh", "-c", "bash /app/ax_browser_broker/browser_pool/bin/launch_chrome.sh pool-a 9223; openbrowser-broker & pid=$!; sleep 3; python /app/g1_smoke.py; result=$?; kill $pid 2>/dev/null || true; wait $pid 2>/dev/null || true; exit $result"]
